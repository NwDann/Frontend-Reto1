{
  "name": "optilogic-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env.server --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env.server server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src server tests vite.config.ts tailwind.config.js",
    "api:types": "node scripts/generate-api-types.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "exceljs": "4.4.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "^3.8.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
