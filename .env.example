# Backend real. El frontend añade /api a las rutas de los recursos.
# Esta URL pública fue comprobada. La URL preview entregada devuelve 401 de Vercel.
VITE_API_BASE_URL=https://backend-reto1-log-stica-env-os-olive.vercel.app
# Cuando habilites el acceso al preview, puedes sustituir la línea anterior por:
# VITE_API_BASE_URL=https://backend-reto1-log-stica-env-git-94d7c4-dannys-projects-b34bf7fa.vercel.app
# Para usar el proxy de desarrollo o del servidor Node opcional: VITE_API_BASE_URL=/api
API_UPSTREAM_URL=https://backend-reto1-log-stica-env-os-olive.vercel.app
# API_UPSTREAM_URL se usa solo con el proxy, no se publica como variable VITE_.
VITE_MAP_PROVIDER=osm
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_OSRM_BASE_URL=https://router.project-osrm.org
# Origen opcional: la API no expone bodegas. Configúralo o selecciónalo en el mapa.
VITE_ORIGIN_LAT=
VITE_ORIGIN_LNG=
VITE_ORIGIN_NAME=Bodega central
