# demo: complete local demonstration; connected: Supabase Auth + companion server.
VITE_DATA_MODE=demo
# URL of the companion server, not the legacy FastAPI. /api uses the Vite proxy.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Optional direct SDK target; the UI imports through the companion server.
VITE_LOGISTICS_API_URL=https://backend-reto1-log-stica-env-os-olive.vercel.app
